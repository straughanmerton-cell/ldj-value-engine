# ------------------------------------------------------------------------------
# 龙德记 AI 高价值锚点与强成交话术系统 V2 —— 环境变量样例
# 复制为 .env 后填写。缺少第三方 Key 不会阻塞主系统：系统会回退到 Mock Provider。
# ------------------------------------------------------------------------------

# 运行环境：development | test | production
NODE_ENV=development

# ---- API 服务 ----
API_HOST=127.0.0.1
API_PORT=4400
API_PUBLIC_URL=http://127.0.0.1:4400
CORS_ORIGINS=http://127.0.0.1:4401

# ---- 数据库（PostgreSQL）----
DATABASE_URL=postgres://ldj:ldj_dev_password@127.0.0.1:55433/ldj_dev
TEST_DATABASE_URL=postgres://ldj:ldj_dev_password@127.0.0.1:55433/ldj_test

# ---- 鉴权 ----
# 生产环境必须替换；至少 32 字符
JWT_SECRET=dev-only-change-me-please-32-chars-min
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# ---- 首个管理员（bootstrap）----
BOOTSTRAP_ADMIN_EMAIL=949412546@qq.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe_123456

# ---- AI Provider（缺失或未填 Key 时自动回退 Mock）----
AI_PROVIDER=mock            # mock | openai | deepseek
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1

# DeepSeek 官方 OpenAI 兼容协议；填了 DEEPSEEK_API_KEY 并把 AI_PROVIDER 设为 deepseek 才生效
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro

# ---- Search Provider（Phase 4 使用；缺失则自动使用 Mock）----
SEARCH_PROVIDER=mock        # mock | tavily
TAVILY_API_KEY=

# ---- Web 前端 ----
VITE_API_BASE_URL=http://127.0.0.1:4400
